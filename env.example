# 数据库连接 (使用 Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname:port/database?sslmode=require"

# Cloudflare R2 对象存储配置
R2_TOKEN="your_cloudflare_r2_token"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
R2_PUBLIC_DOMAIN="https://your_custom_domain"
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_BUCKET_NAME="your_bucket_name"

# 可选：开发环境配置
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 家庭密码登录（必须配置；不要使用 NEXT_PUBLIC_ 前缀）
# npm run auth:setup 可生成本地 .env.local，且不会输出凭证。
MYBABY_APP_PASSWORD=""
MYBABY_SESSION_SECRET=""
# 可选：固定 Origin；生产建议配置真实站点 https origin
MYBABY_APP_ORIGIN=""

# Agent 服务身份与服务器端授权（与浏览器会话独立）
MYBABY_AGENT_TOKEN=""
# [{"source":"weixin","botId":"...","userId":"...","babyId":"..."}]
MYBABY_AGENT_GRANTS='[]'
# 默认关闭；只有协议验收、数据库变更和部署均通过后开启
MYBABY_AGENT_WRITES_ENABLED="false"
